<%- include('partials/header', { activePage: 'register', title: 'Register | Yadhee' }) %>

<div class="auth-page-container" style="position: relative; overflow: hidden;">
    <!-- Glowing background blobs to make glassmorphism pop out -->
    <div class="auth-glow-blob blob-1"></div>
    <div class="auth-glow-blob blob-2"></div>

    <div class="auth-card register-card">
        <!-- Top header row with title and close X button -->
        <div class="auth-header-row">
            <h2 class="auth-title-clean">Sign Up</h2>
            <a href="/" class="auth-close-circle" aria-label="Close Register">
                <i class="fa-solid fa-xmark"></i>
            </a>
        </div>

        <% if (error) { %>
            <div class="auth-error-box-clean">
                <i class="fa-solid fa-circle-exclamation"></i>
                <span><%= error %></span>
            </div>
        <% } %>

        <!-- Registration Form stacked inputs -->
        <form action="/register" method="POST" class="auth-compact-form">
            <div class="auth-compact-group">
                <input type="text" id="username" name="username" required placeholder="Username" autocomplete="username">
            </div>

            <div class="auth-compact-group">
                <input type="email" id="email" name="email" required placeholder="Email Address" autocomplete="email">
            </div>

            <div class="auth-compact-group">
                <input type="password" id="password" name="password" required placeholder="Password" autocomplete="new-password">
            </div>

            <div class="auth-compact-group">
                <input type="tel" id="phone" name="phone" placeholder="Phone Number (Optional)" autocomplete="tel">
            </div>

            <div class="auth-compact-group">
                <textarea id="address" name="address" placeholder="Shipping Address (Optional)" rows="2"></textarea>
            </div>

            <button type="submit" class="auth-blue-btn" style="margin-top: 0.5rem;">
                <i class="fa-solid fa-user-plus"></i> Create Account
            </button>
        </form>

        <div class="auth-compact-footer">
            <p>Already have an account? <a href="/login" class="auth-blue-link">Sign In</a></p>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
