<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login | Yadhee Suite</title>
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Icon library -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --color-bg: #f8fafc;
            --color-card: #ffffff;
            --color-primary: #2563eb;
            --color-primary-hover: #1d4ed8;
            --color-text-main: #1e293b;
            --color-text-muted: #64748b;
            --color-border: #e2e8f0;
            --color-gray-light: #f1f5f9;
            --font-body: 'Figtree', sans-serif;
            --transition-smooth: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            outline: none;
        }

        body {
            background-color: var(--color-bg);
            color: var(--color-text-main);
            font-family: var(--font-body);
            font-weight: 400;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .login-card {
            width: 100%;
            max-width: 440px;
            background: var(--color-card);
            border: 1px solid var(--color-border);
            border-radius: 16px;
            padding: 3rem 2.5rem;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            transition: var(--transition-smooth);
        }

        .logo-box {
            width: 46px;
            height: 46px;
            background: linear-gradient(135deg, #2563eb, #3b82f6);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
            margin-bottom: 1rem;
        }

        .brand-title {
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--color-text-main);
            letter-spacing: -0.02em;
            line-height: 1.2;
            margin-bottom: 0.2rem;
        }

        .brand-subtitle {
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.05em;
            color: var(--color-text-muted);
            text-transform: uppercase;
            margin-bottom: 2rem;
        }

        .form-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--color-text-main);
            margin-bottom: 1.5rem;
            text-align: left;
            width: 100%;
        }

        .luxury-form {
            width: 100%;
        }

        .form-group {
            margin-bottom: 1.25rem;
            text-align: left;
            position: relative;
        }

        label {
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--color-text-main);
            display: block;
            margin-bottom: 0.4rem;
        }

        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-icon {
            position: absolute;
            left: 1rem;
            color: var(--color-text-muted);
            font-size: 0.95rem;
        }

        input {
            width: 100%;
            background: var(--color-gray-light);
            border: 1px solid var(--color-border);
            border-radius: 8px;
            padding: 0.8rem 1rem 0.8rem 2.6rem;
            font-family: var(--font-body);
            color: var(--color-text-main);
            font-size: 0.9rem;
            transition: var(--transition-smooth);
        }

        input:focus {
            outline: none;
            border-color: var(--color-primary);
            background: var(--color-card);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

        .submit-btn {
            width: 100%;
            background-color: var(--color-primary);
            color: #ffffff;
            border: 1px solid var(--color-primary);
            border-radius: 8px;
            padding: 0.9rem;
            font-family: var(--font-body);
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition-smooth);
            margin-top: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.2);
        }

        .submit-btn:hover {
            background-color: var(--color-primary-hover);
            border-color: var(--color-primary-hover);
            transform: translateY(-1px);
            box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.25);
        }

        .error-message {
            background: rgba(244, 63, 94, 0.08);
            border: 1px solid rgba(244, 63, 94, 0.2);
            color: #f43f5e;
            font-size: 0.85rem;
            font-weight: 500;
            padding: 0.75rem 1rem;
            margin-bottom: 1.5rem;
            width: 100%;
            border-radius: 8px;
            text-align: center;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .back-home {
            margin-top: 1.8rem;
            font-size: 0.8rem;
            font-weight: 500;
            color: var(--color-text-muted);
            text-decoration: none;
            transition: var(--transition-smooth);
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

        .back-home:hover {
            color: var(--color-primary);
        }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="logo-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z"/>
                <path d="m9 8 3 4 3-4"/>
                <path d="M12 12v5"/>
            </svg>
        </div>
        <div class="brand-title">Yadhee</div>
        <div class="brand-subtitle">Admin Suite</div>

        <h3 class="form-title">Login to Dashboard</h3>

        <% if (error) { %>
            <div class="error-message">
                <i class="fa-solid fa-triangle-exclamation"></i> <%= error %>
            </div>
        <% } %>

        <form action="/admin/login" method="POST" class="luxury-form">
            <div class="form-group">
                <label for="username">Username</label>
                <div class="input-wrapper">
                    <i class="fa-regular fa-user input-icon"></i>
                    <input type="text" id="username" name="username" required autocomplete="off" placeholder="Enter username...">
                </div>
            </div>
            
            <div class="form-group">
                <label for="password">Password</label>
                <div class="input-wrapper">
                    <i class="fa-solid fa-lock input-icon"></i>
                    <input type="password" id="password" name="password" required placeholder="•••••••••••••••">
                </div>
            </div>

            <button type="submit" class="submit-btn">Continue to Suite <i class="fa-solid fa-arrow-right"></i></button>
        </form>

        <a href="/" class="back-home"><i class="fa-solid fa-arrow-left-long"></i> Return to Storefront</a>
    </div>

</body>
</html>
