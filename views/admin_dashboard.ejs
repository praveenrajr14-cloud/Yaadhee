<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | Yadhee</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Montserrat:wght@300;400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Figtree:wght@300;400;500;600;700&family=Merriweather:ital,wght@0,300;0,400;0,700;1,300&display=swap" rel="stylesheet">
    <!-- FontAwesome icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --color-ivory: #faf8f5; /* Clean light ivory backdrop */
            --color-cream-sidebar: #ffffff; /* White sidebar */
            --color-white: #ffffff;
            --color-gold: #c5a059; /* Brand Gold */
            --color-gold-bright: #b38e4b;
            --color-gold-pale: rgba(197, 160, 89, 0.08);
            --color-crimson: #7a0c1e; /* Brand Crimson */
            --color-crimson-deep: #5e0611;
            --color-dark-ruby: #1e0206; /* Dark Ruby */
            --color-charcoal: #201114; /* Dark maroon-charcoal for readability */
            --color-gray-light: #f7f2f3; /* Soft rose-ivory */
            --color-gray-medium: #ebd8db; /* Soft rose-gray borders */
            --color-gray-dark: #8c6267; /* Dusty rose-maroon for subtexts */
            --color-border: #ebd8db;
            --font-heading: 'Outfit', sans-serif;
            --font-accent: 'Outfit', sans-serif;
            --font-body: 'Outfit', sans-serif;
            --transition-smooth: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            --border-gold-subtle: 1px solid #ebd8db;
            --border-gold-strong: 1px solid #c5a059;
        }

        /* Dark Theme Variables Override */
        body.dark-theme {
            --color-ivory: #150104; /* Very dark ruby */
            --color-cream-sidebar: #1e0206; /* Dark ruby sidebar */
            --color-white: #1e0206;
            --color-gold: #c5a059;
            --color-gold-bright: #d4af37;
            --color-gold-pale: rgba(197, 160, 89, 0.15);
            --color-crimson: #9c1026;
            --color-crimson-deep: #7a0c1e;
            --color-dark-ruby: #0c0002;
            --color-charcoal: #faf8f5;
            --color-gray-light: #150104;
            --color-gray-medium: #2e080d;
            --color-gray-dark: #b58d92; /* Dusty rose-maroon for dark subtexts */
            --color-border: #2e080d;
            --border-gold-subtle: 1px solid #2e080d;
            --border-gold-strong: 1px solid #c5a059;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            outline: none;
        }

        body {
            background-color: var(--color-white);
            color: var(--color-charcoal);
            font-family: var(--font-body);
            font-weight: 300;
            line-height: 1.6;
            overflow-x: hidden;
            transition: background-color 0.4s ease, color 0.4s ease;
        }

        /* Complete Dashboard Layout wrapper */
        .dashboard-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* 1. LEFT SIDEBAR ( tan/beige minimalist mockup ) */
        .sidebar {
            width: 280px;
            background-color: var(--color-cream-sidebar);
            border-right: 1px solid var(--color-border);
            display: flex;
            flex-direction: column;
            padding: 2.5rem 0;
            position: fixed;
            height: 100vh;
            z-index: 100;
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            transition: var(--transition-smooth);
        }

        .sidebar-logo-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 0 1rem;
            margin-bottom: 3rem;
            text-decoration: none;
            text-align: center;
            width: 100%;
        }

        .logo-text {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* Unified Single-Bubble Stock Status Pills */
        .stock-pill {
            display: inline-block;
            padding: 0.3rem 0.8rem;
            font-family: var(--font-body);
            font-weight: 700;
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border-radius: 50px;
            color: #ffffff;
            white-space: nowrap;
            text-align: center;
            line-height: 1.2;
            vertical-align: middle;
        }

        .pill-crimson {
            background-color: var(--color-crimson);
        }

        .pill-green {
            background-color: #4caf50;
        }

        .pill-charcoal {
            background-color: var(--color-charcoal);
        }

        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            padding: 0 1.2rem;
            flex-grow: 1;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 1rem;
            color: var(--color-charcoal);
            text-decoration: none;
            font-family: var(--font-body);
            font-size: 0.85rem;
            font-weight: 400;
            padding: 0.9rem 1.5rem;
            border-radius: 8px;
            transition: var(--transition-smooth);
            position: relative;
        }

        .nav-item i {
            font-size: 1.05rem;
            color: var(--color-gray-dark);
            width: 20px;
            text-align: center;
            transition: var(--transition-smooth);
        }

        /* Active Navigation item styling */
        .nav-item.active {
            background-color: var(--color-gold-bright);
            color: #ffffff;
            font-weight: 600;
            box-shadow: 0 4px 10px rgba(37, 99, 235, 0.15);
        }

        .nav-item.active::before {
            display: none;
        }

        .nav-item.active i {
            color: #ffffff;
        }

        .nav-item:hover:not(.active) {
            background-color: var(--color-gray-light);
            color: var(--color-charcoal);
        }

        .nav-item:hover i {
            color: var(--color-gold-bright);
        }

        /* Sidebar bottom vector line art */
        .sidebar-vector-lines {
            padding: 0 2rem;
            margin-top: auto;
            opacity: 0.65;
        }

        .sidebar-vector-lines svg {
            width: 100%;
            height: auto;
        }

        /* 2. MAIN SPACE AND TOPBAR */
        .main-content {
            margin-left: 280px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            position: relative;
            background-color: var(--color-white);
        }

        /* Top Bar */
        .topbar {
            height: 90px;
            border-bottom: 1px solid var(--color-border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 3.5rem;
            position: sticky;
            top: 0;
            background-color: var(--color-white);
            z-index: 90;
            transition: background-color 0.4s ease, border-bottom 0.4s ease;
        }

        .search-box {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            border: 1px solid var(--color-border);
            border-radius: 8px;
            padding: 0.6rem 1.2rem;
            width: 320px;
            background-color: var(--color-white);
            transition: background-color 0.4s ease, border 0.4s ease;
        }

        .search-box i {
            color: var(--color-gray-dark);
            font-size: 0.9rem;
        }

        .search-box input {
            border: none;
            background: none;
            font-family: var(--font-body);
            font-size: 0.85rem;
            color: var(--color-charcoal);
            width: 100%;
        }

        .profile-section {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .profile-text {
            display: flex;
            flex-direction: column;
            text-align: right;
        }

        .profile-name {
            font-family: var(--font-body);
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--color-charcoal);
        }

        .profile-info {
            font-family: var(--font-body);
            font-size: 0.7rem;
            color: var(--color-gray-dark);
        }

        .profile-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            overflow: hidden;
            border: 1px solid var(--color-gold);
        }

        .profile-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* 3. MAIN WORKSPACE TAB AREA */
        .workspace {
            padding: 3rem 3.5rem;
            padding-bottom: 6rem;
            flex-grow: 1;
            background-color: var(--color-ivory);
            transition: background-color 0.4s ease;
        }

        .tab-panel {
            display: none;
            animation: fadeIn 0.4s ease forwards;
        }

        .tab-panel.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Header Row (Product Management title) */
        .page-header-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2.5rem;
        }

        .page-title {
            font-family: var(--font-heading);
            font-size: 2rem;
            font-weight: 400;
            color: var(--color-charcoal);
            letter-spacing: 0.02em;
        }

        /* Clean gold border card button */
        .add-new-btn {
            background-color: var(--color-gold-bright);
            border: 1px solid var(--color-gold-bright);
            color: #ffffff;
            font-family: var(--font-body);
            font-size: 0.85rem;
            font-weight: 600;
            padding: 0.8rem 1.8rem;
            border-radius: 8px;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(37, 99, 235, 0.15);
            transition: var(--transition-smooth);
        }

        .add-new-btn:hover {
            background-color: var(--color-crimson-deep);
            border-color: var(--color-crimson-deep);
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.25);
        }

        /* Stats & Sparkline Widget Row */
        .widget-row {
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: 2rem;
            margin-bottom: 2.5rem;
        }

        .sales-overview-card {
            background-color: var(--color-white);
            border: 1px solid var(--color-border);
            border-radius: 12px;
            padding: 1.2rem 1.5rem;
            box-shadow: 0 4px 20px rgba(0,0,0,0.01);
            display: flex;
            flex-direction: column;
            gap: 0.6rem;
            position: relative;
            overflow: hidden;
            transition: var(--transition-smooth);
        }

        .sales-overview-card::after {
            display: none;
        }

        .sales-overview-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.03);
            border-color: var(--color-gold);
        }

        /* SVG Interactive points */
        .interactive-dot {
            transition: r 0.3s ease, fill 0.3s ease;
            cursor: pointer;
        }
        .interactive-dot:hover {
            r: 7 !important;
            fill: var(--color-crimson) !important;
        }

        .overview-title {
            font-family: var(--font-body);
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--color-charcoal);
            letter-spacing: 0.02em;
        }

        .overview-chart {
            width: 100%;
            height: 60px;
        }

        .sparkline-svg {
            width: 100%;
            height: 100%;
        }

        /* Modern Header bar */
        .table-header-bar {
            background-color: var(--color-gray-light);
            border: 1px solid var(--color-border);
            border-radius: 8px;
            padding: 0.8rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }

        .col-left {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .header-checkbox, .item-checkbox {
            accent-color: var(--color-gold);
            width: 16px;
            height: 16px;
            cursor: pointer;
        }

        .header-label {
            font-family: var(--font-body);
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--color-gray-dark);
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .col-right {
            padding-right: 4.5rem;
        }

        /* 2-COLUMN MASTERPIECE CARDS GRID */
        .products-cards-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .masterpiece-card {
            background-color: var(--color-white);
            border: 1.2px solid #EADCC9;
            border-radius: 12px;
            padding: 1.2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.01);
            transition: var(--transition-smooth);
        }

        .masterpiece-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(197, 160, 89, 0.05);
            border-color: var(--color-gold);
        }

        .card-left {
            display: flex;
            align-items: center;
            gap: 1.2rem;
            flex-grow: 1;
        }

        .card-media {
            width: 70px;
            height: 70px;
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid var(--color-gray-light);
            background-color: var(--color-cream-sidebar);
            flex-shrink: 0;
        }

        .card-media img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
        }

        .masterpiece-card:hover .card-media img {
            transform: scale(1.08);
        }

        .card-info {
            display: flex;
            flex-direction: column;
            gap: 0.2rem;
        }

        .card-name {
            font-family: var(--font-body);
            font-size: 0.88rem;
            font-weight: 600;
            color: var(--color-charcoal);
        }

        .card-meta {
            display: flex;
            flex-direction: column;
            gap: 0.1rem;
            font-family: var(--font-body);
            font-size: 0.75rem;
            color: var(--color-gray-dark);
        }

        .meta-price {
            font-weight: 500;
            color: var(--color-charcoal);
        }

        .meta-alert {
            color: var(--color-crimson);
            font-weight: 600;
            font-size: 0.7rem;
            margin-top: 0.1rem;
            display: flex;
            align-items: center;
            gap: 0.2rem;
        }

        .card-right {
            display: flex;
            align-items: center;
            padding-right: 1rem;
        }

        .card-action-links {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            font-family: var(--font-body);
            font-size: 0.8rem;
        }

        .edit-link {
            color: var(--color-gold);
            text-decoration: none;
            font-weight: 500;
            transition: var(--transition-smooth);
        }

        .edit-link:hover {
            color: var(--color-crimson);
        }

        .actions-dropdown {
            position: relative;
        }

        .actions-link {
            color: var(--color-gold);
            text-decoration: none;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 0.3rem;
            transition: var(--transition-smooth);
        }

        .actions-link:hover {
            color: var(--color-crimson);
        }

        .dropdown-menu-list {
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            background-color: var(--color-white);
            border: 1px solid #EADCC9;
            box-shadow: var(--shadow-luxury);
            border-radius: 8px;
            width: 140px;
            z-index: 10;
            display: none;
            overflow: hidden;
        }

        .dropdown-menu-list.active {
            display: block;
        }

        .menu-item-btn {
            background: none;
            border: none;
            width: 100%;
            padding: 0.6rem 1rem;
            font-family: var(--font-body);
            font-size: 0.75rem;
            text-align: left;
            cursor: pointer;
            color: var(--color-charcoal);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: var(--transition-smooth);
        }

        .menu-item-btn:hover {
            background-color: var(--color-gray-light);
            color: var(--color-gold-bright);
        }

        /* 4. FLOATING DEVELOPER PANEL (Payment Simulator) */
        .floating-payment-simulator {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 320px;
            background-color: var(--color-white);
            border: 1px solid var(--color-border);
            border-radius: 12px;
            box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);
            z-index: 1000;
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
        }

        .floating-payment-simulator.minimized {
            width: 240px;
            padding: 0.8rem 1.2rem;
            bottom: 20px;
            right: 20px;
            gap: 0;
        }

        .floating-payment-simulator.minimized .simulator-body {
            display: none;
        }

        @keyframes slideUp {
            from { transform: translateY(40px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        .simulator-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1.2px solid var(--color-border);
            padding-bottom: 0.6rem;
        }

        .floating-payment-simulator.minimized .simulator-header {
            border-bottom: none;
            padding-bottom: 0;
        }

        .sim-toggle-btn {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--color-gray-dark);
            padding: 0.2rem;
            font-size: 0.85rem;
            transition: var(--transition-smooth);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sim-toggle-btn:hover {
            color: var(--color-crimson);
        }

        .floating-payment-simulator.minimized .sim-toggle-btn i {
            transform: rotate(180deg);
        }

        .sim-title {
            font-family: var(--font-body);
            font-size: 0.88rem;
            font-weight: 700;
            color: var(--color-charcoal);
            letter-spacing: 0.02em;
        }

        .simulator-body {
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
        }

        .sim-group {
            display: flex;
            flex-direction: column;
        }

        .sim-select {
            border: 1px solid var(--color-gray-medium);
            border-radius: 6px;
            padding: 0.6rem;
            font-family: var(--font-body);
            font-size: 0.8rem;
            background-color: var(--color-white);
            color: var(--color-charcoal);
            cursor: pointer;
            width: 100%;
        }

        .sim-btn {
            background-color: var(--color-white);
            border: 1px solid var(--color-gold);
            color: var(--color-charcoal);
            border-radius: 6px;
            padding: 0.6rem;
            font-family: var(--font-body);
            font-size: 0.8rem;
            font-weight: 500;
            cursor: pointer;
            transition: var(--transition-smooth);
            width: 100%;
        }

        .sim-btn:hover {
            background-color: var(--color-gray-light);
            border-color: var(--color-gold-bright);
        }

        .sim-links {
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
            border-top: 1px solid var(--color-border);
            padding-top: 0.6rem;
        }

        .sim-link {
            font-family: var(--font-body);
            font-size: 0.72rem;
            color: var(--color-gray-dark);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.4rem;
            transition: var(--transition-smooth);
        }

        .sim-link:hover {
            color: var(--color-gold);
        }

        /* 5. TABS: SECURE DISPATCHES (ORDERS) */
        .luxury-table-wrapper {
            background-color: var(--color-white);
            border: 1px solid #EADCC9;
            border-radius: 12px;
            padding: 1.5rem;
            overflow-x: auto;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.01);
        }

        .luxury-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 0.85rem;
        }

        .luxury-table th {
            font-family: var(--font-body);
            font-weight: 600;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            color: var(--color-gold);
            padding: 1rem 1.2rem;
            border-bottom: 2px solid var(--color-gray-light);
            font-size: 0.72rem;
        }

        .luxury-table td {
            padding: 1.1rem 1.2rem;
            border-bottom: 1px solid var(--color-gray-light);
            color: var(--color-charcoal);
        }

        .luxury-table tr:hover {
            background-color: var(--color-gray-light);
        }

        .status-badge {
            font-size: 0.65rem;
            font-weight: 600;
            padding: 0.3rem 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            display: inline-block;
            border-radius: 4px;
        }
        .status-badge.Pending { background: #FFF9E6; color: #D48E00; border: 1px solid #FFE499; }
        .status-badge.Processing { background: #E6F0FF; color: #0066CC; border: 1px solid #99CCFF; }
        .status-badge.Shipped { background: #F0F9EB; color: #67C23A; border: 1px solid #C2E7B0; }
        .status-badge.Delivered { background: #F5F7FA; color: #909399; border: 1px solid #DCDFE6; }

        .btn-action-group {
            display: flex;
            gap: 0.4rem;
        }

        .action-btn-sm {
            background: none;
            border: 1px solid var(--color-gray-medium);
            padding: 0.4rem 0.8rem;
            font-size: 0.72rem;
            font-family: var(--font-body);
            cursor: pointer;
            color: var(--color-charcoal);
            border-radius: 4px;
            transition: var(--transition-smooth);
        }

        .action-btn-sm:hover {
            border-color: var(--color-gold);
            color: var(--color-gold);
        }

        /* 6. CRUD DIALOGS POPUPS */
        .admin-modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(30, 2, 6, 0.6);
            z-index: 3000;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transition: var(--transition-smooth);
        }

        .admin-modal-overlay.active {
            opacity: 1;
            pointer-events: auto;
        }

