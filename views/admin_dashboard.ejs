                            <thead>
                                <tr>
                                    <th>Order ID</th>
                                    <th>Patron Details</th>
                                    <th>Transit Address</th>
                                    <th>Value (INR)</th>
                                    <th>Fulfillment</th>
                                    <th>Actions</th>
                                </tr>
