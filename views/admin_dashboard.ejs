                                    <th style="padding:1rem; text-align:center; font-size:0.75rem; text-transform:uppercase; color:var(--color-gold-bright);">Expected Delivery</th>
                                    <th style="padding:1rem; text-align:center; font-size:0.75rem; text-transform:uppercase; color:var(--color-gold-bright);">Sovereign Archives</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (purchaseOrders.length === 0) { %>
