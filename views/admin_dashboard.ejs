                        <h1 class="page-title">Patron Chronicles Inner Circle</h1>
                        <a href="/admin/export/subscribers" class="admin-theme-btn" style="background-color: var(--color-crimson); border: none; color: #fff; padding: 0.6rem 1.2rem; border-radius: 4px; font-family: var(--font-accent); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; display: flex; align-items: center; gap: 0.5rem;">
                            <i class="fa-solid fa-file-csv"></i> Export CSV
