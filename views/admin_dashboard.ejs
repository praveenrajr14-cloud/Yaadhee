                                            <div>
                                                <div style="font-weight:600; color:var(--color-charcoal); font-size:0.88rem;"><%= p.name %></div>
                                                <div style="font-size:0.7rem; color:var(--color-gray-dark); font-family:monospace; margin-top:2px;">SKU ID: <%= p.id %></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td style="padding:1rem; color:var(--color-gray-dark); font-size:0.82rem;"><%= p.type %> (<%= p.subcategory %>)</td>
                                    <td style="padding:1rem; text-align:right; font-weight:600; color:var(--color-charcoal); font-size:0.85rem;">₹<%= p.price_inr.toLocaleString('en-IN') %></td>
                                    <td style="padding:1rem; text-align:center; vertical-align:middle;">
                                        <div style="display:inline-flex; align-items:center; gap:0.3rem; border:1px solid var(--color-gold-medium); border-radius:4px; background:#FCFAF7; padding:0.15rem;">
