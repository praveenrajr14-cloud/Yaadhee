                                    <th style="padding:1rem; text-align:left; font-size:0.75rem; text-transform:uppercase; color:var(--color-gold-bright);">Itemized Materials</th>
                                    <th style="padding:1rem; text-align:center; font-size:0.75rem; text-transform:uppercase; color:var(--color-gold-bright);">Qty</th>
