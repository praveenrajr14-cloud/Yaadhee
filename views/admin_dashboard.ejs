                <section id="couponsTab" class="tab-panel">
                    <div class="page-header-row" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
                        <h1 class="page-title">Promo Coupon Codes</h1>
                        <button onclick="toggleCouponModal(true)" class="admin-theme-btn" style="background-color: var(--color-gold); border: none; color: #fff; padding: 0.6rem 1.2rem; border-radius: 4px; font-family: var(--font-accent); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer; display: flex; align-items: center; gap: 0.5rem;">
                            <i class="fa-solid fa-plus"></i> Create Coupon
                        </button>
                    </div>

                    <div class="luxury-table-wrapper">
                        <table class="luxury-table">
                            <thead>
                                <tr>
                                    <th>Coupon Code</th>
                                    <th>Discount Type</th>
                                    <th>Discount Value</th>
                                    <th>Expiry Date</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% coupons.forEach(function(c) { %>
                                <tr>
                                    <td><strong style="color: var(--color-crimson); font-family: var(--font-accent); font-size: 0.82rem; letter-spacing: 0.05em;"><%= c.code %></strong></td>
                                    <td><span style="text-transform: capitalize; font-weight: 500;"><%= c.discount_type %></span></td>
                                    <td>
                                        <strong>
                                            <%= c.discount_type === 'percent' ? c.value + '%' : '₹' + c.value.toLocaleString('en-IN') %>
                                        </strong>
                                    </td>
                                    <td>
                                        <span style="font-size: 0.76rem;"><%= c.expires_at ? c.expires_at : 'Never Expires' %></span>
                                    </td>
                                    <td>
                                        <% if (c.is_active === 1) { %>
                                            <span class="status-badge Delivered" style="white-space: nowrap;">Active</span>
                                        <% } else { %>
                                            <span class="status-badge Pending" style="white-space: nowrap;">Inactive</span>
                                        <% } %>
                                    </td>
                                    <td style="display: flex; gap: 0.5rem; align-items: center;">
                                        <form action="/admin/coupons/toggle/<%= c.id %>" method="POST" style="margin:0;">
                                            <input type="hidden" name="is_active" value="<%= c.is_active %>">
                                            <button type="submit" class="action-btn-sm" style="border-color: var(--color-gold); color: var(--color-gold); font-weight: 500;">
                                                <%= c.is_active === 1 ? 'Disable' : 'Enable' %>
                                            </button>
                                        </form>
                                        <form action="/admin/coupons/delete/<%= c.id %>" method="POST" style="margin:0;" onsubmit="return confirm('Are you sure you want to delete this coupon?');">
                                            <button type="submit" class="action-btn-sm" style="border-color: var(--color-crimson); color: var(--color-crimson); font-weight: 500;">
                                                Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                                <% }); %>
                                <% if (coupons.length === 0) { %>
                                <tr>
                                    <td colspan="6" style="text-align: center; color: var(--color-gray-dark); font-style: italic; padding: 2rem;">No coupons registered yet.</td>
                                </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </section>

                <!-- ============================================================= -->
