                                <% } else { %>
                                    <% purchaseOrders.forEach(function(po) { %>
                                        <tr style="border-bottom:1px solid var(--color-gray-medium);">
                                            <td style="padding:1rem; font-weight:600; color:var(--color-charcoal); font-size:0.85rem;">YDH-2026-PO-<%= po.id %></td>
