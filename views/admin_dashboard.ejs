                                            <td style="padding:1rem; text-align:center; font-weight:600; font-size:0.82rem;"><%= po.quantity %></td>
                                            <td style="padding:1rem; text-align:right; font-weight:600; color:var(--color-crimson); font-size:0.85rem;">₹<%= po.total_cost_inr.toLocaleString('en-IN') %></td>
                                            <td style="padding:1rem; text-align:center; vertical-align:middle;">
                                                <form action="/admin/po/status/<%= po.id %>" method="POST" style="display:inline-block; margin:0;">
                                                    <select name="status" onchange="this.form.submit()" style="padding:0.25rem 0.5rem; font-size:0.75rem; border:1px solid var(--color-gold-medium); border-radius:4px; background:#fff; font-weight:600; color:var(--color-charcoal); cursor:pointer;">
                                                        <option value="Raised" <%= po.status === 'Raised' ? 'selected' : '' %>>Raised</option>
                                                        <option value="Approved" <%= po.status === 'Approved' ? 'selected' : '' %>>Approved</option>
                                                        <option value="Received" <%= po.status === 'Received' ? 'selected' : '' %>>Received</option>
                                                    </select>
