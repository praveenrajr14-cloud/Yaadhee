                                            <div style="font-size: 0.72rem; margin-top: 0.3rem; color: var(--color-gray-dark); font-weight: 500;">
                                                <%= o.carrier %>: <%= o.tracking_id %>
                                            </div>
                                        <% } %>
                                    </td>
                                    <td>
