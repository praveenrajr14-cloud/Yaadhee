            border: 1px solid var(--color-gray-medium);
            border-radius: 6px;
            padding: 0.8rem 1rem;
            font-family: var(--font-body);
            font-size: 0.85rem;
            background-color: var(--color-ivory);
            transition: var(--transition-smooth);
